rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - email: string (required, email)
    //   - role: string (required, 'admin' | 'user')
    //   - displayName: string
    //   - photoURL: string
    //
    // Collection: patients
    // Document ID: {patientId}
    // Fields:
    //   - name: string (required, < 100 chars)
    //   - dob: string
    //   - email: string (email)
    //   - age: number
    //   - phone: string
    //   - visitDate: string
    //   - doctorName: string
    //   - notes: string (< 2000 chars)
    //   - data: map (audiometry data)
    //   - diagnosis: string
    //   - ambientNoise: number
    //   - uid: string (required, matches owner)
    //   - createdAt: string (required, ISO8601)
    //
    // Collection: tasks
    // Document ID: {taskId}
    // Fields:
    //   - title: string (required, < 500 chars)
    //   - completed: bool (required)
    //   - uid: string (required, matches owner)
    //   - createdAt: string (required, ISO8601)
    //
    // Collection: notes
    // Document ID: {noteId}
    // Fields:
    //   - content: string (required, < 5000 chars)
    //   - uid: string (required, matches owner)
    //   - createdAt: string (required, ISO8601)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "alhasann2023@gmail.com" ||
        request.auth.token.email == "nashwann1991@gmail.com"
      );
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.email is string;
    }

    function isValidPatient(data) {
      return data.uid == request.auth.uid;
    }

    function isValidTask(data) {
      return data.uid == request.auth.uid;
    }

    function isValidNote(data) {
      return data.uid == request.auth.uid;
    }

    function isValidPresence(data) {
      return data.uid == request.auth.uid && 
             data.displayName is string &&
             data.lastActive is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /patients/{patientId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && isValidPatient(request.resource.data);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid) && uidNotModified();
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /presence/{patientId}/users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidPresence(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && isValidTask(request.resource.data);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid) && uidNotModified();
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && isValidNote(request.resource.data);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid) && uidNotModified();
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
